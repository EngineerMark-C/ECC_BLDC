    {
        "id": "580524c311fa4aa5",
        "type": "function",
        "z": "8863af5168db98a5",
        "name": "格式化状态数据",
        "func": "// 将收到的数据转换为字符串\nlet str = msg.payload.toString();\n\n// 检查是否是状态数据\nif (str.indexOf('status:') === 0) {\n    // 提取速度和角度\n    let match = str.match(/speed=([\\-0-9]+),angle=([\\-0-9\\.]+)/);\n    if (match) {\n        return {\n            payload: {\n                speed: parseInt(match[1]),\n                angle: parseFloat(match[2])\n            }\n        };\n    }\n}\n\n// 如果无法解析，返回原始数据\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 500,
        "wires": [
